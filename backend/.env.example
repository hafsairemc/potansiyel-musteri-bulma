# Veritabanı ve Supabase
APP_ENV=development
USE_REMOTE_DB=true
AUTO_CREATE_SCHEMA=false
DATABASE_URL=postgresql://user:password@localhost:5432/pusula_db
ASYNC_DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
PRODUCT_IMAGES_BUCKET=product-images
REPORTS_BUCKET=reports

# Güvenlik & Kimlik Doğrulama
JWT_SECRET=your-super-secret-jwt-key
DEV_MODE=false
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=devpassword123
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Dış Servis API Anahtarları (İsteğe Bağlı)
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
SERPER_API_KEY=your-serper-api-key
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
HERE_API_KEY=
RADAR_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Harita ve Arama Ayarları
MAP_SEARCH_CITIES=İstanbul,Ankara,İzmir,Bursa,Antalya,Mersin,Adana,Gaziantep
MAPS_MAX_CITY_QUERIES=8
CRAWLER_MAX_QUERIES=12
CRAWLER_MAX_RESULTS_PER_JOB=50
MAX_COUNTRIES_PER_BATCH=10
FAIR_ENRICH_LIMIT=25
FAIR_MAX_ROWS=100
MAX_UPLOAD_MB=10

# Kuyruk ve Ziyaretçi Takip Ayarları
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_MODE=celery
VISITOR_RETENTION_DAYS=90
TRUST_PROXY_HEADERS=false
VISITOR_NOTIFICATION_WEBHOOK=
ADMIN_EMAILS=
ENFORCE_PLAN_LIMITS=false

# E-posta Kampanya & Yanıt Ayarları
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_EVENT_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
PUBLIC_BASE_URL=http://127.0.0.1:5000

# B2B ve Hata Takip
B2B_PUBLISH_WEBHOOK_URL=
B2B_PUBLISH_WEBHOOK_TOKEN=
SENTRY_DSN=
